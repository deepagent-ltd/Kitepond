+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""An explicitly bound control frame on Mooncake's native peer socket."""
+
+from typing import Final
+
+# c1 is reserved by MessagePack and cannot prefix a native request.
+_CONTROL_FRAME: Final = b"\xc1vllm-mc-control\x01"
+MOONCAKE_CONTROL_BODY_MAX: Final = 192 * 1024
+_NAME_CHARS: Final = frozenset(b"abcdefghijklmnopqrstuvwxyz0123456789._-")
+
+
+def validate_mooncake_control_name(name: str) -> bytes:
+    if type(name) is not str or not name.isascii():
+        raise ValueError("Invalid Mooncake control namespace")
+    value = name.encode("ascii")
+    if not 1 <= len(value) <= 63 or not all(char in _NAME_CHARS for char in value):
+        raise ValueError("Invalid Mooncake control namespace")
+    return value
+
+
+def validate_mooncake_control_body(data: bytes) -> None:
+    if type(data) is not bytes or not 0 < len(data) <= MOONCAKE_CONTROL_BODY_MAX:
+        raise ValueError("Invalid Mooncake control body length")
+
+
+def encode_mooncake_control_message(name: str, data: bytes) -> bytes:
+    namespace = validate_mooncake_control_name(name)
+    validate_mooncake_control_body(data)
+    return _CONTROL_FRAME + namespace + b"\x00" + data
+
+
+def decode_mooncake_control_message(packet: bytes) -> tuple[str, bytes] | None:
+    if not packet.startswith(_CONTROL_FRAME):
+        return None
+    if len(packet) > len(_CONTROL_FRAME) + 64 + MOONCAKE_CONTROL_BODY_MAX:
+        raise ValueError("Invalid Mooncake control frame length")
+    frame = packet[len(_CONTROL_FRAME) :]
+    name, separator, body = frame.partition(b"\x00")
+    if not separator or not name.isascii():
+        raise ValueError("Invalid Mooncake control namespace")
+    namespace = name.decode("ascii")
+    validate_mooncake_control_name(namespace)
+    validate_mooncake_control_body(body)
+    return namespace, body
