+    def stage_draft_row_mirrors(self, num_tokens: int) -> None:
+        state = self._draft_slot_mapping_staging
+        if state is None or not self._draft_mirror_pending or not num_tokens:
+            return
+        slots = self.cache_handles[self._draft_layers[0]].slot_mapping
+        assert slots is not None
+        start = state.num_tokens
+        end = start + num_tokens
+        if num_tokens > slots.numel() or end > state.slots.numel():
+            raise ValueError("HiSparse draft row mapping exceeds staging capacity.")
+        # The native drafter overwrites the persistent mapping on the compute
+        # stream for each forward. Snapshot it on that stream before replay.
+        state.slots[start:end].copy_(slots[:num_tokens], non_blocking=True)
+        state.event.record(torch.accelerator.current_stream())
+        state.num_tokens = end
+
