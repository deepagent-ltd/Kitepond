@@ -0,0 +1,174 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import multiprocessing as mp
+import os
+from collections import deque
+from contextlib import contextmanager
+from dataclasses import fields
+from threading import Lock
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.distributed.device_communicators.shm_broadcast import MessageQueue
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.executor.multiproc_executor import MultiprocExecutor, WorkerProc
+from vllm.v1.outputs import ModelRunnerOutput
+
+LATE = {"utility": "old-owner-response"}
+REQUEST = SchedulerOutput.make_empty()
+MODEL_OUTPUT_FIELDS = {field.name for field in fields(ModelRunnerOutput)}
+MODEL_OUTPUT_REQ_ID = "synthetic-new-model-request"
+MODEL_OUTPUT_EXTRA = (
+    {"req_id_to_index": {MODEL_OUTPUT_REQ_ID: 0}}
+    if "req_id_to_index" in MODEL_OUTPUT_FIELDS
+    else {}
+)
+FRESH = ModelRunnerOutput(req_ids=[MODEL_OUTPUT_REQ_ID], **MODEL_OUTPUT_EXTRA)
+
+
+class CpuWorker:
+    def __init__(self, rank, delayed_rank, entered, complete):
+        self.rank = rank
+        self.delayed_rank = delayed_rank
+        self.entered = entered
+        self.complete = complete
+
+    def owner_resolve(self):
+        if self.rank == self.delayed_rank:
+            self.entered.set()
+            if not self.complete.wait(10):
+                raise RuntimeError("CPU fixture did not release the delayed owner call")
+            return LATE
+        return {"utility": "first-rank-response"}
+
+    def execute_model(self, scheduler_output):
+        assert isinstance(scheduler_output, SchedulerOutput)
+        return FRESH
+
+
+def run_worker(rank, requests, send_reply, delayed_rank, entered, complete):
+    replies = MessageQueue(1, 1, max_chunk_bytes=64 * 1024, max_chunks=4)
+    send_reply.send(replies.export_handle())
+    send_reply.close()
+    worker = WorkerProc.__new__(WorkerProc)
+    worker.rank = rank
+    worker.worker = CpuWorker(rank, delayed_rank, entered, complete)
+    worker.use_async_scheduling = False
+    worker.rpc_broadcast_mq = MessageQueue.create_from_handle(requests, rank)
+    worker.worker_response_mq = replies
+    worker.rpc_broadcast_mq.wait_until_ready()
+    replies.wait_until_ready()
+    worker.worker_busy_loop()
+
+
+@contextmanager
+def native_executor(delayed_rank):
+    ctx = mp.get_context("spawn")
+    requests = MessageQueue(2, 2, max_chunk_bytes=64 * 1024, max_chunks=4)
+    entered, complete = ctx.Event(), ctx.Event()
+    workers, replies, handles = [], [], []
+    try:
+        for rank in range(2):
+            recv_reply, send_reply = ctx.Pipe(duplex=False)
+            proc = ctx.Process(
+                target=run_worker,
+                args=(
+                    rank,
+                    requests.export_handle(),
+                    send_reply,
+                    delayed_rank,
+                    entered,
+                    complete,
+                ),
+            )
+            proc.start()
+            workers.append(proc)
+            send_reply.close()
+            handles.append(recv_reply)
+        for handle in handles:
+            assert handle.poll(20), "CPU worker transport did not publish its queue"
+            replies.append(MessageQueue.create_from_handle(handle.recv(), 0))
+        requests.wait_until_ready()
+        for reply in replies:
+            reply.wait_until_ready()
+
+        executor = MultiprocExecutor.__new__(MultiprocExecutor)
+        executor.is_failed = False
+        executor.failure_callback = None
+        executor._failure_lock = Lock()
+        executor.rpc_broadcast_mq = requests
+        executor.response_mqs = replies
+        executor.futures_queue = deque()
+        executor.output_rank = delayed_rank
+        executor.kv_output_aggregator = None
+        executor.ec_output_aggregator = None
+        executor.vllm_config = SimpleNamespace(
+            parallel_config=SimpleNamespace(enable_fault_tolerance=False)
+        )
+        notifications = []
+        executor.register_failure_callback(lambda: notifications.append("failed"))
+        assert executor.execute_model(REQUEST) == FRESH
+        yield executor, entered, complete, notifications
+    finally:
+        complete.set()
+        for worker in workers:
+            worker.terminate()
+        for worker in workers:
+            worker.join(3)
+            if worker.is_alive():
+                worker.kill()
+                worker.join(3)
+        for handle in handles:
+            handle.close()
+        for queue in (*replies, requests):
+            queue.shutdown()
+
+
+@pytest.mark.parametrize("output_rank", [0, 1])
+def test_execute_after_a_timed_out_owner_call(output_rank):
+    with native_executor(output_rank) as (executor, entered, complete, notifications):
+        with pytest.raises(TimeoutError, match="RPC call to owner_resolve timed out"):
+            executor.collective_rpc("owner_resolve", timeout=0.3)
+        assert entered.is_set(), "the selected worker must really have the timed RPC"
+        complete.set()
+        try:
+            result = executor.execute_model(REQUEST)
+        except RuntimeError as error:
+            assert str(error) == "Executor failed."
+        else:
+            assert result != LATE, "native execute_model consumed the delayed utility reply"
+            pytest.fail("the timed-out executor accepted a replacement model RPC")
+        assert notifications == ["failed"]
+        assert not executor.futures_queue
+
+
+def test_enqueued_model_future_cannot_consume_late_owner_reply():
+    with native_executor(1) as (executor, entered, complete, notifications):
+        owner_future = executor.collective_rpc(
+            "owner_resolve", timeout=0.3, non_block=True
+        )
+        assert entered.wait(5)
+        model_future = executor.execute_model(REQUEST, non_block=True)
+        with pytest.raises(TimeoutError, match="RPC call to owner_resolve timed out"):
+            owner_future.result()
+
+        if os.environ.get("VLLM_RPC_EXPECT_UNPATCHED") == "1":
+            # Drive the old executor to a ready reply before checking output
+            # provenance. On the fixed executor poll resolves while the
+            # original worker is still waiting, with no response available.
+            complete.set()
+            try:
+                result = model_future.result()
+            except RuntimeError as error:
+                assert str(error) == "Executor failed."
+            else:
+                assert result != LATE, "native model future consumed the delayed reply"
+                pytest.fail("the executor accepted an enqueued model response")
+        else:
+            assert model_future.poll(), "poisoned futures must finish without a late frame"
+            with pytest.raises(RuntimeError, match="Executor failed."):
+                model_future.result()
+        assert notifications == ["failed"]
+        assert not executor.futures_queue
