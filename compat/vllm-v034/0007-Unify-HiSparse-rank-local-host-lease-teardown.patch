+@pytest.mark.parametrize("abi", ["typed", "tuple", "tensor"])
+def test_rank_local_provider_normalizes_old_and_new_returns(monkeypatch, abi):
+    config, pool, backing, factory, pin, release = _make_pool(monkeypatch, tp=8)
+    config.kv_transfer_config.kv_connector_extra_config.pop("host_pool_allocator")
+    config.additional_config["hisparse_host_buffer_provider"] = "my_plugin.acquire"
+    if abi == "tuple":
+        factory.return_value = (backing, release)
+    elif abi == "tensor":
+        factory.return_value = backing
+
+    events = []
+    backend = SimpleNamespace(
+        unpin_tensor=lambda tensor: events.append(("unpin", tensor))
+    )
+    monkeypatch.setattr(runtime, "get_hisparse_backend", lambda: backend)
+    monkeypatch.setattr(torch.accelerator, "synchronize", lambda: events.append("sync"))
+    pin.side_effect = lambda tensor: events.append(("pin", tensor))
+    release.side_effect = lambda: events.append("release")
+
+    assert pool.allocate(17).data_ptr() == backing.data_ptr()
+    factory.assert_called_once_with(config, pool.kv_cache_config, 17)
+    runtime.release_rank_local_hisparse_host_pool(config)
+    runtime.release_rank_local_hisparse_host_pool(config)
+    expected = [("pin", backing), "sync", ("unpin", backing)]
+    if abi != "tensor":
+        expected.append("release")
+    assert events == expected
+    assert config.instance_id not in runtime._host_pools
+
+
+@pytest.mark.parametrize("failure", ["synchronize", "unregister", "release"])
+def test_failed_teardown_preserves_lease_until_retry(monkeypatch, failure):
+    config, pool, _, _, _, release = _make_pool(monkeypatch)
+    sync = Mock()
+    backend = Mock()
+    monkeypatch.setattr(torch.accelerator, "synchronize", sync)
+    monkeypatch.setattr(runtime, "get_hisparse_backend", lambda: backend)
+    pool.allocate(17)
+    if failure == "synchronize":
+        sync.side_effect = [RuntimeError("sync failed"), None]
+    elif failure == "unregister":
+        backend.unpin_tensor.side_effect = [RuntimeError("unpin failed"), None]
+    else:
+        release.side_effect = [RuntimeError("release failed"), None]
+
+    if failure == "release":
+        with pytest.raises(RuntimeError, match="release failed"):
+            runtime.release_rank_local_hisparse_host_pool(config)
+        assert release.call_count == 1
+    else:
+        runtime.release_rank_local_hisparse_host_pool(config)
+        release.assert_not_called()
+    assert runtime._host_pools[config.instance_id] is pool
+    with pytest.raises(RuntimeError, match="retiring"):
+        pool.allocate(17)
+    if failure == "synchronize":
+        backend.unpin_tensor.assert_not_called()
+
+    runtime.release_rank_local_hisparse_host_pool(config)
+    assert config.instance_id not in runtime._host_pools
+    assert release.call_count == (2 if failure == "release" else 1)
+    assert backend.unpin_tensor.call_count == (2 if failure == "unregister" else 1)
+
+
+def test_conflicting_providers_fail_before_allocation(monkeypatch):
+    config, pool, _, factory, pin, release = _make_pool(monkeypatch)
+    config.additional_config["hisparse_host_buffer_provider"] = "my_plugin.acquire"
+    with pytest.raises(ValueError, match="Configure only one"):
+        pool.allocate(17)
+    runtime.resolve_obj_by_qualname.assert_not_called()
+    factory.assert_not_called()
+    pin.assert_not_called()
+    release.assert_not_called()
+
+
+def test_missing_provider_fails_without_native_fallback(monkeypatch):
+    config, pool, _, _, pin, _ = _make_pool(monkeypatch)
+    config.additional_config["hisparse_host_buffer_provider"] = "absent.acquire"
+    config.kv_transfer_config.kv_connector_extra_config.pop("host_pool_allocator")
+    native_allocate = Mock()
+    monkeypatch.setattr(runtime, "allocate_pinned_host_pool", native_allocate)
+    runtime.resolve_obj_by_qualname.side_effect = ModuleNotFoundError("absent")
+    with pytest.raises(ModuleNotFoundError, match="absent"):
+        pool.allocate(17)
+    pin.assert_not_called()
+    native_allocate.assert_not_called()
