From 144c28a1fe9c9c4e868ebf6e2ba4ff6b573936c0 Mon Sep 17 00:00:00 2001
From: deepagent-ai <deepagent-ai@deepagent.ltd>
Date: Mon, 23 Nov 2026 11:40:04 +0000
Subject: [PATCH] Admit native Full GLM NVFP4 DCP8 MTP3 on SM120

---
 vllm/config/vllm.py                           |  8 ++
 .../backends/mla/flashinfer_mla_sparse.py     |  5 +-
 .../mla/flashinfer_mla_sparse_sm120.py        | 19 +++-
 vllm/v1/hisparse/dcp_layout.py                | 86 ++++++++++++++++++-
 vllm/v1/hisparse/runtime.py                   | 25 +++++-
 5 files changed, 133 insertions(+), 10 deletions(-)

diff --git a/vllm/config/vllm.py b/vllm/config/vllm.py
index 85fa121..705ade7 100644
--- a/vllm/config/vllm.py
+++ b/vllm/config/vllm.py
@@ -1815,6 +1815,14 @@ class VllmConfig:
         ):
             raise ValueError("GLM Flash DCP8 MTP3 requires HiSparse DCP8.")
 
+        if (
+            self.attention_config.enable_glm53_full_dcp8
+            and self.speculative_config is not None
+        ):
+            from vllm.v1.hisparse.dcp_layout import validate_glm53_full_dcp8_mtp3
+
+            validate_glm53_full_dcp8_mtp3(self)
+
         if self.attention_config.hisparse_config is not None:
             if current_platform.get_hisparse_backend_cls() is None:
                 raise ValueError("The current platform does not support HiSparse.")
diff --git a/vllm/v1/attention/backends/mla/flashinfer_mla_sparse.py b/vllm/v1/attention/backends/mla/flashinfer_mla_sparse.py
index 1487a78..625d5cc 100644
--- a/vllm/v1/attention/backends/mla/flashinfer_mla_sparse.py
+++ b/vllm/v1/attention/backends/mla/flashinfer_mla_sparse.py
@@ -255,8 +255,8 @@ class FlashInferMLASparseSM120Backend(_FlashInferMLASparseBackendBase):
                 return (
                     "Experimental GLM-5.3 full DCP8 requires "
                     "SM120, FlashInfer >= 0.7.3, packed fp8_ds_mla B64, "
-                    "TP8/EP8/DCP8, interleave 4, ag_rs without Q replication, "
-                    "and MTP disabled"
+                    "and TP8/EP8/DCP8 with interleave 4 and ag_rs "
+                    "without Q replication"
                 )
             hisparse = vllm_config.attention_config.hisparse_config
             if hisparse is not None:
@@ -347,7 +347,6 @@ class FlashInferMLASparseSM120Backend(_FlashInferMLASparseBackendBase):
             and not parallel.use_ubatching
             and not parallel.enable_eplb
             and not parallel.enable_elastic_ep
-            and config.speculative_config is None
         )
 
 
diff --git a/vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py b/vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py
index 8788c75..cc01e54 100644
--- a/vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py
+++ b/vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py
@@ -101,11 +101,22 @@ class FlashInferMLASparseSM120Impl(SparseMLACommonImpl[FlashInferMLASparseMetada
             )
         self.kv_scale_format = _kv_scale_format_for_model(model_type)
         self.supports_mtp_with_cp_non_trivial_interleave_size = (
-            vllm_config.attention_config.enable_glm_flash_dcp8_mtp3
-            and self.dcp_world_size == 8
-            and head_size == self.kv_lora_rank == 512
-            and self.qk_rope_head_dim == 0
+            self.dcp_world_size == 8
+            and self.kv_lora_rank == 512
             and self.kv_scale_format == "arbitrary_fp32"
+            and (
+                (
+                    vllm_config.attention_config.enable_glm_flash_dcp8_mtp3
+                    and head_size == 512
+                    and self.qk_rope_head_dim == 0
+                )
+                or (
+                    vllm_config.attention_config.enable_glm53_full_dcp8
+                    and vllm_config.speculative_config is not None
+                    and head_size == 576
+                    and self.qk_rope_head_dim == 64
+                )
+            )
         )
 
         from vllm.utils.flashinfer import has_flashinfer_sparse_mla_sm120
diff --git a/vllm/v1/hisparse/dcp_layout.py b/vllm/v1/hisparse/dcp_layout.py
index edaac82..4b028e0 100644
--- a/vllm/v1/hisparse/dcp_layout.py
+++ b/vllm/v1/hisparse/dcp_layout.py
@@ -43,6 +43,7 @@ class HiSparseDCPLayout:
     minimum_host_blocks: int
     device_layout: "KVCacheLayout"
     packed_row_bytes: int = 528
+    full_draft_source_layers: int = 0
 
 
 def _dcp8_source_geometry(config: VllmConfig) -> tuple[int, int]:
@@ -84,6 +85,7 @@ def validate_hisparse_dcp8_config(config: VllmConfig) -> None:
     if (
         config.speculative_config is not None
         and not config.attention_config.enable_glm_flash_dcp8_mtp3
+        and not config.attention_config.enable_glm53_full_dcp8
     ):
         raise ValueError("HiSparse DCP8 requires explicit MTP3 opt-in.")
 
@@ -205,6 +207,77 @@ def validate_hisparse_dcp8_config(config: VllmConfig) -> None:
         _validate_glm_flash_dcp8_mtp3(config, is_flash_nvfp4, physical_rows)
 
 
+def validate_glm53_full_dcp8_mtp3(config: VllmConfig) -> None:
+    """Keep resident and host-backed Full GLM on the same fixed MTP route."""
+    from vllm.v1.attention.backends.mla.flashinfer_mla_sparse import (
+        FlashInferMLASparseSM120Backend,
+    )
+    from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+    attention = config.attention_config
+    backend = attention.backend_per_kind.get("mla_attention", attention.backend)
+    sparse = attention.hisparse_config
+    model = config.model_config
+    cache = config.cache_config
+    spec = config.speculative_config
+    draft = spec.draft_model_config if spec is not None else None
+    if (
+        not FlashInferMLASparseSM120Backend.supports_glm53_full_dcp8(config)
+        or not current_platform.is_cuda()
+        or current_platform.get_device_capability() != DeviceCapability(12, 0)
+        or backend != AttentionBackendEnum.FLASHINFER_MLA_SPARSE_SM120
+        or attention.enable_glm_flash_dcp8_mtp3
+        or not cache.user_specified_block_size
+        or cache.block_size != 64
+        or cache.cache_dtype != "fp8_ds_mla"
+        or cache.enable_prefix_caching
+        or cache.enable_extensible_kv_cache is not False
+        or (sparse is None and config.kv_transfer_config is not None)
+        or (
+            sparse is not None
+            and (
+                not sparse.enable_dcp8
+                or sparse.indexer_block_size is not None
+                or sparse.pack_hot_groups
+                or sparse.full_glm_b64_row_alias
+                or sparse.device_buffer_size is not None
+            )
+        )
+        or config.compilation_config.cudagraph_mode != CUDAGraphMode.FULL_AND_PIECEWISE
+        or model is None
+        or model.enforce_eager
+        or model.max_model_len > 131072
+        or config.scheduler_config.max_num_seqs > 32
+        or config.scheduler_config.max_num_batched_tokens > 2048
+        or spec is None
+        or spec.method != "mtp"
+        or spec.custom_method is not None
+        or spec.num_speculative_tokens != 3
+        or spec.uses_dynamic_speculative_decoding()
+        or spec.enable_adaptive_verification
+        or spec.rejection_sample_method != "standard"
+        or spec.draft_sample_method != "greedy"
+        or spec.draft_tensor_parallel_size != 8
+        or spec.draft_decode_context_parallel_size != 8
+        or spec.enforce_eager
+        or spec.kv_cache_dtype not in (None, "fp8_ds_mla")
+        or draft is None
+        or draft.architecture != "DeepseekV32MTPModel"
+        or getattr(draft.hf_config, "model_type", None) != "deepseek_mtp"
+        or spec.num_mtp_modules() != 1
+        or not getattr(draft.hf_config, "index_share_for_mtp_iteration", False)
+        or draft.max_model_len != model.max_model_len
+        or draft.quantization != model.quantization
+        or spec.model != (model.model_weights or model.model)
+    ):
+        raise ValueError(
+            "Full GLM-5.3 HiSparse DCP8 MTP3 requires native packed-RoPE B64, "
+            "FULL_AND_PIECEWISE graphs, the same checkpoint's single "
+            "DeepseekV32 MTP layer with draft TP8/DCP8, and at most 131072 "
+            "context tokens, 32 sequences, and 2048 batched tokens."
+        )
+
+
 def _validate_glm_flash_dcp8_mtp3(
     config: VllmConfig, is_flash_nvfp4: bool, physical_rows: int
 ) -> None:
@@ -271,7 +344,14 @@ def validate_dcp8_rank_agreement(
     local_matches = (
         local_matches
         and geometry in ((256, 528), (64, 656))
-        and (geometry != (64, 656) or len(host_group.layer_names) == 78)
+        and (
+            geometry != (64, 656)
+            or (
+                len(host_group.layer_names) == 78 + layout.full_draft_source_layers
+                and sum(spec.is_draft for spec in iter_layer_specs(host))
+                == layout.full_draft_source_layers
+            )
+        )
         and all(
             isinstance(spec, MLAAttentionSpec)
             and spec.cache_dtype_str == "fp8_ds_mla"
@@ -295,6 +375,7 @@ def validate_dcp8_rank_agreement(
         layout.interleave,
         layout.physical_page_rows,
         layout.packed_row_bytes,
+        layout.full_draft_source_layers,
         layout.logical_page_tokens,
         layout.minimum_host_blocks,
         layout.device_layout.name,
@@ -407,6 +488,9 @@ def require_hisparse_dcp_layout(
         minimum_host_blocks=host_blocks,
         device_layout=layout,
         packed_row_bytes=packed_row_bytes,
+        full_draft_source_layers=int(
+            packed_row_bytes == 656 and config.speculative_config is not None
+        ),
     )
     # Ordinary DCP/LSE support is insufficient. This explicitly selected
     # runner must verify its HiSparse staging, mirroring and physical readers.
diff --git a/vllm/v1/hisparse/runtime.py b/vllm/v1/hisparse/runtime.py
index 8a71f42..daf0075 100644
--- a/vllm/v1/hisparse/runtime.py
+++ b/vllm/v1/hisparse/runtime.py
@@ -146,11 +146,32 @@ class ResolvedHiSparseConfig:
 
         max_query_len = max_decode_query_len(vllm_config)
         min_device_buffer_size = max_query_len * model_top_k
+        default_device_buffer_size = (max_query_len + 1) * model_top_k
+        if (
+            vllm_config.attention_config.enable_glm53_full_dcp8
+            and config.enable_dcp8
+            and vllm_config.speculative_config is not None
+            and vllm_config.model_config.max_model_len <= 16384
+        ):
+            parallel = vllm_config.parallel_config
+            interleave = parallel.cp_kv_cache_interleave_size
+            dcp_size = parallel.decode_context_parallel_size
+            # The resolver receives only causal, rank-local row IDs. Include
+            # one verification group's tail as slack and round up across every
+            # DCP rank so the same bound holds for the entire group.
+            max_local_rows = interleave * cdiv(
+                vllm_config.model_config.max_model_len + max_query_len,
+                dcp_size * interleave,
+            )
+            min_device_buffer_size = min(min_device_buffer_size, max_local_rows)
+            default_device_buffer_size = min(
+                default_device_buffer_size, round_up(max_local_rows, 64)
+            )
         # Retain the worst-case union of every speculative step's top-k and
-        # leave one additional top-k of LRU slack.
+        # leave LRU slack unless the hot region already fits every local row.
         configured_size = config.device_buffer_size
         if configured_size is None:
-            device_buffer_size = (max_query_len + 1) * model_top_k
+            device_buffer_size = default_device_buffer_size
         else:
             device_buffer_size = configured_size
 
-- 
2.43.0

