+        SpeculativeConfig(
+            method="mtp",
+            num_speculative_tokens=3,
+            target_model_config=model,
+            target_parallel_config=parallel,
+        )
+        if mtp
+        else None
+    )
+    return VllmConfig(
+        model_config=model,
+        cache_config=CacheConfig(
+            block_size=256,
+            cache_dtype="fp8_ds_mla",
+            mamba_cache_mode="align",
+            mamba_cache_dtype="bfloat16",
+            mamba_ssm_cache_dtype="float32",
+        ),
+        parallel_config=parallel,
+        speculative_config=spec,
+    )
+
+
+def _layer_shell(cls, **attrs):
+    layer = object.__new__(cls)
+    if isinstance(layer, nn.Module):
+        nn.Module.__init__(layer)
+    for key, value in attrs.items():
+        setattr(layer, key, value)
+    return layer
+
+
+def _layers(config):
+    model = config.model_config
+    text = model.hf_text_config
+    cache = config.cache_config
+    backend = FlashInferMLASparseSM120Backend
+    impl = _layer_shell(
+        backend.get_impl_cls(),
+        kv_lora_rank=text.kv_lora_rank,
+        qk_rope_head_dim=text.qk_rope_head_dim,
+    )
+    source = _layer_shell(
+        MLAAttention,
+        kv_cache_dtype=cache.cache_dtype,
+        head_size=model.get_head_size(),
+        impl=impl,
+        sliding_window=None,
+        topk_buffer_width=text.index_topk,
+        indexer=object(),
+        non_causal_multi_token_decode=False,
+        attn_backend=backend,
+    )
+    index = _layer_shell(
+        Glm5NextIndexerCache,
+        cache_config=cache,
+        _index_kpool=text.index_kpool,
+        head_dim=text.index_head_dim + text.index_head_dim // 128 * 4,
+        dtype=torch.uint8,
+    )
+    tail = _layer_shell(
+        Glm5NextTailCache,
+        cache_config=cache,
+        _index_kpool=text.index_kpool,
+        head_dim=text.index_head_dim,
+        dtype=torch.bfloat16,
+    )
+    kda = _layer_shell(
+        Glm5NextLinearAttention,
+        model_config=model,
+        cache_config=cache,
+        kda_prefill_backend="flashkda",
+        tp_size=config.parallel_config.tensor_parallel_size,
+        num_heads=text.linear_num_heads,
+        head_dim=text.linear_head_dim,
+        conv_size=text.linear_conv_kernel_dim,
+        num_spec=config.num_speculative_tokens,
+    )
+    config.compilation_config.static_forward_context.update(
+        source=source,
+        kpool=index,
+        tail=tail,
+        kda=kda,
+    )
+    return impl
