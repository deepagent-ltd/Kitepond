+    model = vllm_config.model_config
+    parallel = vllm_config.parallel_config
+    if (
+        (model.architecture, compress_ratio)
+        not in (
+            ("Glm5NextForConditionalGeneration", 4),
+            ("GlmMoeDsaForCausalLM", 1),
+        )
+        or parallel.tensor_parallel_size != 8
+        or parallel.decode_context_parallel_size != 8
+        or parallel.prefill_context_parallel_size != 1
+        or parallel.cp_kv_cache_interleave_size != 4
+        or not current_platform.is_cuda()
+        or not current_platform.is_device_capability_family(120)
+    ):
+        return legacy_rows
+
+    compressed_max_len = model.max_model_len // compress_ratio
+    compressed_interleave = parallel.cp_kv_cache_interleave_size // compress_ratio
+    stripes, remainder = divmod(
+        compressed_max_len,
+        parallel.decode_context_parallel_size * compressed_interleave,
+    )
+    # The first rank owns the largest shard of every request. PCP1 gather
+    # packs valid rows without cache-page padding between requests.
+    max_local_rows_per_req = (
+        stripes * compressed_interleave + min(remainder, compressed_interleave)
+    )
+    return min(
+        legacy_rows,
+        max(1, vllm_config.scheduler_config.max_num_seqs * max_local_rows_per_req),
+    )
