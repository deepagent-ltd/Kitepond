+
+
+@pytest.mark.parametrize("rank", range(8))
+def test_dcp8_synthetic_prefill_has_no_scheduler_owned_writes(
+    model, monkeypatch, rank
+):
+    builder = _builder(model, monkeypatch, rank, dcp=8)
+    query_start = torch.tensor([0, 9, 19], dtype=torch.int32)
+    lengths = torch.tensor([9, 10], dtype=torch.int32)
+    metadata = CommonAttentionMetadata(
+        query_start_loc=query_start,
+        query_start_loc_cpu=query_start,
+        seq_lens=lengths,
+        seq_lens_cpu_upper_bound=lengths,
+        num_reqs=2,
+        num_actual_tokens=19,
+        max_query_len=10,
+        max_seq_len=10,
+        block_table_tensor=torch.zeros((2, 2), dtype=torch.int32),
+        slot_mapping=torch.full((19,), -1, dtype=torch.int64),
+        positions=torch.zeros(19, dtype=torch.int64),
+        is_prefilling=torch.zeros(2, dtype=torch.bool),
+        is_dummy=True,
