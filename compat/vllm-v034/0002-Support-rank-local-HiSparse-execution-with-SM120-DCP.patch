+class _CpuAttentionMetadata(CommonAttentionMetadata):
+    def token_to_req_indices(
+        self, output_buffer: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        # The native mapping kernel is GPU-only. These CPU tensors provide the
+        # equivalent query index input to the real sparse staging builder.
+        counts = torch.diff(self.query_start_loc_cpu)
+        req_ids = torch.arange(self.num_reqs, dtype=torch.int32)
+        result = req_ids.repeat_interleave(counts)
+        if output_buffer is None:
+            return result
+        output = output_buffer[: result.numel()]
+        output.copy_(result)
+        return output
+
+
