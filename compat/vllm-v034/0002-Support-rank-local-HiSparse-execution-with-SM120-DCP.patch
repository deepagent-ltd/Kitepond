+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.compilation.breakable_cudagraph import (
+    BreakableCUDAGraphCapture,
+    eager_break_during_capture,
+)
+from vllm.config import CUDAGraphMode
+from vllm.forward_context import ForwardContext, override_forward_context
+from vllm.model_executor.layers.attention.mla_attention import (
+    unified_mla_kv_cache_update,
+)
+
+
+class _CPUDeviceGraph:
+    """Model the CUDA boundary without replaying host-side code."""
+
+    def capture_begin(self):
+        pass
+
+    def capture_end(self):
+        pass
+
+    def replay(self):
+        pass
+
+
+class _CacheUpdateObserver:
+    def __init__(self, hisparse):
+        self.hisparse_cache = object() if hisparse else None
+        self.kv_cache = torch.empty(0)
+        self.swap_cursor = 0
+        self.prepared = None
+        self.writes = []
+
+    def prepare_kv_cache_update(self, metadata):
+        self.swap_cursor = 0
+        self.prepared = metadata
+
+    def update_kv_cache(self, _kv, _rope, _cache, slots, metadata, _dtype, _scale):
+        self.writes.append((metadata, slots.tolist()))
+
+    def reserve_attention_rows(self, rows):
+        self.swap_cursor += rows
+        if self.swap_cursor > 64:
+            raise ValueError(f"HiSparse swap exhausted at {self.swap_cursor} rows")
+        return self.prepared, self.writes[-1]
+
+
+def _forward_context(layer, mode, marker):
+    return override_forward_context(
+        ForwardContext(
+            no_compile_layers={"mla": layer},
+            attn_metadata={"mla": marker},
+            slot_mapping={"mla": torch.tensor([marker])},
+            cudagraph_runtime_mode=mode,
+        )
+    )
+
+
+def test_hisparse_mla_piecewise_replay_reprepares_current_batch(monkeypatch):
+    monkeypatch.setattr(torch.cuda, "CUDAGraph", _CPUDeviceGraph)
+    layer = _CacheUpdateObserver(hisparse=True)
+    capture = BreakableCUDAGraphCapture()
+    latent = torch.empty(28, 0)
+    attention_batches = []
+
+    @eager_break_during_capture
+    def run_attention():
+        attention_batches.append(layer.reserve_attention_rows(28))
+
+    with _forward_context(layer, CUDAGraphMode.PIECEWISE, 3), capture:
+        unified_mla_kv_cache_update(latent, latent, "mla", "fp8_ds_mla", latent)
+        run_attention()
+    for marker in (17, 51):
+        with _forward_context(layer, CUDAGraphMode.PIECEWISE, marker):
+            capture.replay()
+    assert attention_batches == [(3, (3, [3])), (17, (17, [17])), (51, (51, [51]))]
+
+
+@pytest.mark.parametrize(
+    ("hisparse", "mode"),
+    [(True, CUDAGraphMode.FULL), (False, CUDAGraphMode.PIECEWISE)],
+)
+def test_mla_other_cache_updates_stay_in_the_cuda_segment(monkeypatch, hisparse, mode):
+    monkeypatch.setattr(torch.cuda, "CUDAGraph", _CPUDeviceGraph)
+    layer = _CacheUpdateObserver(hisparse)
+    capture = BreakableCUDAGraphCapture()
+    latent = torch.empty(0)
+    with _forward_context(layer, mode, 7), capture:
+        unified_mla_kv_cache_update(latent, latent, "mla", "fp8_ds_mla", latent)
+    assert capture.num_eager_breaks == 0
+    assert layer.writes == [(7, [7])]
