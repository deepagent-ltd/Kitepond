+def test_rank_local_packed_rope_launch_and_softmax_merge(monkeypatch):
+    """Compare no-cache test vectors at the public FlashInfer CPU boundary.
+
+    Triton executes its real row remap in interpreter mode. The CUDA launch
+    boundary uses CPU arithmetic on the 656-byte payload.
+    """
+    from triton.runtime.interpreter import InterpretedFunction
+
+    core = pytest.importorskip("flashinfer.mla._core")
+    prepared = pytest.importorskip("flashinfer.mla._sparse_mla_sm120._prepared")
+    remap = sparse_utils._CONVERT_REQ_INDEX_TO_GLOBAL_INDEX_KERNEL
+    if not isinstance(remap.kernel, InterpretedFunction):
+        pytest.skip("test requires TRITON_INTERPRET=1")
+    monkeypatch.setattr(core, "is_sm12x_supported", lambda _: True)
+    monkeypatch.setattr(core, "get_compute_capability", lambda _: (12, 0))
+
+    positions = ([0, 5, 9, 12, 31, 510, 511, 512, 516, 525], [4, 5], [])
+    topk = torch.full((len(positions), 2048), -1, dtype=torch.int32)
+    for row, choices in zip(topk, positions, strict=True):
+        row[: len(choices)] = torch.tensor(choices, dtype=torch.int32)
+    physical_stride = 5312  # 3,484,672 bytes of native BLHNC stride at B64.
+    table = torch.tensor([[1, 2]], dtype=torch.int32)
+    metadata = SimpleNamespace(
+        topk_start=0,
+        block_size=64,
+        block_table=table,
+        req_id_per_token=torch.zeros(3, dtype=torch.int32),
+        num_decode_tokens=3,
+        cp_kv_cache_interleave_size=4,
+    )
+    q_latent = torch.zeros((3, 64, 512), dtype=torch.bfloat16)
+    q_latent[:, :, 0] = 1.0
+    q_latent[:, :, 129] = -1.0
+    q_rope = torch.zeros((3, 64, 64), dtype=torch.bfloat16)
+    q_rope[:, :, 0] = 2.0
+    calls = []
+
+    def launch(
+        query,
+        cache,
+        indices,
+        output,
+        workspace,
+        scale,
+        *,
+        lengths,
+        lse,
+        kv_scale_format,
+        lse_scale,
+        **kwargs,
+    ):
+        assert query.shape == (3, 64, 576) and query.dtype == torch.bfloat16
+        assert cache.size(-1) == 656 and cache.size(-2) == 64
+        assert cache.dtype == torch.uint8 and output.shape == (3, 64, 512)
+        assert kv_scale_format == "arbitrary_fp32" and lse_scale == 1.0
+        assert lengths.dtype == torch.int32 and lengths.shape == (3,)
+        assert lse.dtype == torch.float32 and lse.shape == (3, 64)
+        assert indices.shape == (3, 2048)
+        calls.append((indices.clone(), lengths.clone(), lse.data_ptr()))
+        packed = cache.reshape(-1, 656)
+        output.zero_()
+        lse.fill_(float("-inf"))
+        for row, length in enumerate(lengths.tolist()):
+            assert (indices[row, length:] == -1).all()
+            if not length:
+                continue
+            payload = packed[indices[row, :length]]
+            scales = payload[:, 512:528].view(torch.float32).repeat_interleave(128, -1)
+            kv_latent = payload[:, :512].view(torch.float8_e4m3fn).float() * scales
+            kv_rope = payload[:, 528:].view(torch.bfloat16).float()
+            logits = (
+                query[row, :, :512].float() @ kv_latent.t()
+                + query[row, :, 512:].float() @ kv_rope.t()
+            ) * scale
+            output[row].copy_((torch.softmax(logits, -1) @ kv_latent).to(output.dtype))
+            lse[row].copy_(torch.logsumexp(logits, -1) / math.log(2))
+        return lse
+
+    monkeypatch.setattr(prepared, "functional_run", launch)
+    outputs, state = [], []
+    for rank in range(8):
+        impl = object.__new__(FlashInferMLASparseSM120Impl)
+        impl.dcp_world_size = 8
+        impl.dcp_rank = rank
+        impl.need_to_return_lse_for_decode = True
+        impl.index_group = None
+        impl.topk_indices_buffer = topk
+        impl.num_heads = 8
+        impl.kv_lora_rank = 512
+        impl.qk_nope_head_dim = 192
+        impl.qk_rope_head_dim = 64
+        impl.kv_scale_format = _kv_scale_format_for_model("glm_moe_dsa")
+        impl.scale = 0.125
+        impl._workspace_buffer = torch.empty(128, dtype=torch.uint8)
+        assert impl.get_fp8_ds_mla_row_bytes() == 656
+        backing = torch.zeros((2 * physical_stride + 64, 656), dtype=torch.uint8)
+        cache = backing.as_strided((3, 64, 656), (physical_stride * 656, 656, 1))
+        owned = sorted(
+            {
+                pos
+                for choice in positions
+                for pos in choice
+                if _rank_slot(pos)[0] == rank
+            }
+        )
+        for position, payload in zip(owned, _packed_rows(owned), strict=True):
+            _, slot = _rank_slot(position)
+            cache[slot // 64 + 1, slot % 64] = payload
+        out, lse = impl.forward_mqa((q_latent, q_rope), cache, metadata, None)
+        outputs.append(out.float())
+        state.append(lse)
+        indices, lengths, lse_pointer = calls[-1]
+        assert lse_pointer == lse.data_ptr()
+        for row, choices in enumerate(positions):
+            local = [
+                slot
+                for p in choices
+                for owner, slot in [_rank_slot(p)]
+                if owner == rank
+            ]
+            expected = [(s // 64 + 1) * physical_stride + s % 64 for s in local]
+            assert indices[row, : lengths[row]].tolist() == expected
+            if not expected:
+                assert torch.isneginf(lse[row]).all()
+                assert not out[row].count_nonzero()
+
+    weights = torch.stack(state).exp2()
+    merged = (torch.stack(outputs) * weights[..., None]).sum(0)
+    merged /= weights.sum(0).clamp_min(1e-10)[..., None]
+    for row, choices in enumerate(positions):
+        if not choices:
+            assert merged[row].count_nonzero() == 0
+            continue
+        latent, rope = _token_vectors(choices)
+        no_rope_logits = q_latent[row].float() @ latent.T
+        logits = (no_rope_logits + q_rope[row].float() @ rope.T) * impl.scale
+        reference = torch.softmax(logits, -1) @ latent
+        no_rope_reference = torch.softmax(no_rope_logits * impl.scale, -1) @ latent
+        assert (reference - no_rope_reference).abs().amax() > 0.01
+        torch.testing.assert_close(merged[row], reference, atol=0.012, rtol=0)
