+def _rank_slot(position: int) -> tuple[int, int]:
+    stripe, lane = divmod(position, 4)
+    return stripe % 8, stripe // 8 * 4 + lane
+
+
+def _token_vectors(token_ids):
+    ids = torch.as_tensor(token_ids, dtype=torch.int64)
+    latent = torch.zeros((ids.numel(), 512), dtype=torch.float32)
+    rope = torch.zeros((ids.numel(), 64), dtype=torch.float32)
+    latent[:, 0] = ids % 7 - 3
+    latent[:, 129] = ids % 5 + 1
+    rope[:, 0] = ids % 3 * 2 - 2
+    return latent, rope
+
+
+def _packed_rows(token_ids):
+    latent, rope = _token_vectors(token_ids)
+    scales = torch.tensor([0.5, 2.0, 0.25, 1.0]).expand(len(token_ids), 4).contiguous()
+    quant = (latent / scales.repeat_interleave(128, dim=-1)).to(torch.float8_e4m3fn)
+    return torch.cat(
+        [
+            quant.view(torch.uint8),
+            scales.view(torch.uint8),
+            rope.to(torch.bfloat16).view(torch.uint8),
+        ],
+        dim=-1,
+    )
+
