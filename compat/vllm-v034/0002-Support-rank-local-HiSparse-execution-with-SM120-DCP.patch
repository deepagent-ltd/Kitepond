+@pytest.mark.parametrize("dcp_rank", [None, *range(8)])
+def test_hisparse_step_localizes_dcp_row_mirrors(monkeypatch, dcp_rank):
+    """Scheduled spans become this rank's DMA addresses before slot filtering."""
+    physical_page = 256
+    dcp_size = 8 if dcp_rank is not None else 1
+    interleave = 4
+    logical_page = physical_page * dcp_size
+    mirrors = (
+        SparseKVRowMirror(
+            (6 * logical_page - 10, 10 * logical_page - 10),
+            8 * logical_page - 10,
+            10,
+        ),
+        SparseKVRowMirror((6 * logical_page, 10 * logical_page), 8 * logical_page, 29),
+    )
+    worker = _make_hisparse_worker()
+    worker._dcp_mirror_geometry = (
+        (dcp_size, dcp_rank, interleave) if dcp_rank is not None else None
+    )
+    worker.kernel_block_size = physical_page
+    worker.cache_handles = _as_cache_handles(
+        SimpleNamespace(runtime=SimpleNamespace(eager_host_mirror=True))
+    )
+    worker._post_forward_transfers = []
+    worker._pending_invalid_block_ids = []
+    worker._slot_mapping_staging = _SlotMappingStaging(
+        stream=MagicMock(), event=MagicMock(), slots=torch.empty(0, dtype=torch.int64)
+    )
+    monkeypatch.setattr(torch.accelerator, "current_stream", MagicMock())
+
+    worker.start_step(
+        SimpleNamespace(
+            row_mirrors={"request": mirrors},
+            all_context_pages_resident=True,
+            host_block_copies=(),
+            command=None,
+            source_block_ids=(),
+            residency_updates={},
+        ),
+        None,
+        ["request"],
+    )
+
+    # A token-by-token oracle independently filters global offsets by owner.
+    expected = []
+    owned = [
+        row
+        for row in range(logical_page)
+        if (row // interleave) % dcp_size == (dcp_rank or 0)
+    ]
+    for mirror in mirrors:
+        dest_page, offset = divmod(mirror.destination_start, logical_page)
+        local = [
+            i for i, row in enumerate(owned) if offset <= row < offset + mirror.num_rows
+        ]
+        if local:
+            expected.append(
+                SparseKVRowMirror(
+                    tuple(
+                        (start // logical_page) * physical_page + local[0]
+                        for start in mirror.source_starts
+                    ),
+                    dest_page * physical_page + local[0],
+                    len(local),
+                )
+            )
+    assert worker._row_mirrors == tuple(expected)
+    assert worker._slot_mapping_staging.candidates == tuple(expected)
