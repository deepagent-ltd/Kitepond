@@ -0,0 +1,326 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native MQA metadata with rank-local prefix and current writer rows."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.v1.hisparse import _native_plan as native_plan
+from vllm.config import HiSparseConfig, ParallelConfig
+from vllm.model_executor.layers.attention import sparse_mla_attention
+from vllm.v1.attention.backend import CommonAttentionMetadata
+from vllm.v1.attention.backends.mla.flashinfer_mla_sparse import (
+    FlashInferMLASparseSM120Backend,
+)
+from vllm.v1.attention.backends.mla.index_group import HiSparseMLAIndexGroup
+from vllm.v1.attention.ops.dcp import MLADCPManager
+from vllm.v1.hisparse.backend import HiSparseBackend
+from vllm.v1.hisparse.runtime import HiSparseCacheHandle, HiSparseRuntime
+
+model = native_plan.model
+BLOCK = 256
+
+
+def _builder(model, monkeypatch, rank, *, dcp=4):
+    if dcp == 8:
+        config = native_plan._config(model, mtp=False)
+        config.parallel_config = ParallelConfig(
+            tensor_parallel_size=8,
+            decode_context_parallel_size=8,
+            cp_kv_cache_interleave_size=4,
+        )
+    else:
+        config = native_plan._config(model, dcp=dcp)
+    # Match the selected MQA-only SM120 model. The public HiSparse+DCP launch
+    # validation is tested separately and remains closed during CPU review.
+    config.attention_config.hisparse_config = HiSparseConfig()
+    config.compilation_config.static_forward_context["mla"] = SimpleNamespace(
+        prefill_backend=None,
+        dcp_manager=object.__new__(MLADCPManager),
+    )
+    monkeypatch.setattr(
+        sparse_mla_attention,
+        "get_dcp_group",
+        lambda: SimpleNamespace(world_size=dcp, rank_in_group=rank),
+    )
+    monkeypatch.setattr(sparse_mla_attention, "PIN_MEMORY", False)
+    native_plan._layers(config)
+    layer = config.compilation_config.static_forward_context["source"]
+    spec = layer.get_kv_cache_spec(config)
+    return FlashInferMLASparseSM120Backend.get_builder_cls()(
+        spec, ["mla"], config, torch.device("cpu")
+    )
+
+
+def _slots(host_blocks, positions, q_starts, rank, *, dcp):
+    rows = []
+    for i, table in enumerate(host_blocks):
+        for position in positions[q_starts[i] : q_starts[i + 1]]:
+            if dcp == 1:
+                local = position
+            elif position // 4 % dcp != rank:
+                rows.append(-1)
+                continue
+            else:
+                local = position // (4 * dcp) * 4 + position % 4
+            block, offset = divmod(local, BLOCK)
+            rows.append(table[block] * BLOCK + offset)
+    return torch.tensor(rows, dtype=torch.int64)
+
+
+def _metadata(rank, *, dcp=4, decode_only=False, with_positions=True, warm_query=9):
+    block_table = [
+        [61, 62, 63],
+        [7, 9, 69],
+        [7, 11, 70],
+        [13, 0, 72],
+        [91, 92, 93],
+    ]
+    if dcp == 1:
+        block_table[0] = list(range(41, 50))
+        block_table[1] = list(range(51, 60))
+        block_table[2] = list(range(60, 69))
+        block_table[3] = list(range(70, 79))
+        block_table[4] = list(range(81, 90))
+    lengths = [2064, 1025, 1033, 9, 0]
+    queries = [4, 1, warm_query, 9, 0]
+    is_prefilling = [False, True, True, True, False]
+    if decode_only:
+        block_table = block_table[:1]
+        lengths = lengths[:1]
+        queries = queries[:1]
+        is_prefilling = is_prefilling[:1]
+    positions = []
+    q_starts = [0]
+    token_to_req = []
+    for i, (end, query_len) in enumerate(zip(lengths, queries, strict=True)):
+        positions.extend(range(end - query_len, end))
+        q_starts.append(q_starts[-1] + query_len)
+        token_to_req.extend([i] * query_len)
+    seq_lens = torch.tensor(lengths, dtype=torch.int32)
+    query_start = torch.tensor(q_starts, dtype=torch.int32)
+    return CommonAttentionMetadata(
+        query_start_loc=query_start,
+        query_start_loc_cpu=query_start,
+        seq_lens=seq_lens,
+        seq_lens_cpu_upper_bound=seq_lens,
+        num_reqs=len(lengths),
+        num_actual_tokens=q_starts[-1],
+        max_query_len=max(queries),
+        max_seq_len=max(lengths),
+        block_table_tensor=torch.tensor(block_table, dtype=torch.int32),
+        slot_mapping=_slots(block_table, positions, q_starts, rank, dcp=dcp),
+        is_prefilling=torch.tensor(is_prefilling),
+        positions=(
+            torch.tensor(positions, dtype=torch.int64) if with_positions else None
+        ),
+        # Same shared rank-local map the runner supplies. Its Triton launch
+        # is outside this CPU metadata fixture.
+        _token_to_req_indices_cache=torch.tensor(token_to_req, dtype=torch.int32),
+    )
+
+
+def _actual_mixed_builder(model, monkeypatch, rank, with_positions=True):
+    builder = _builder(model, monkeypatch, rank)
+    common = _metadata(rank, with_positions=with_positions)
+    return builder.build(0, common), common
+
+
+def test_shared_dcp1_mqa_behavior(model, monkeypatch):
+    builder = _builder(model, monkeypatch, rank=0, dcp=1)
+    built = builder.build(0, _metadata(0, dcp=1))
+    assert built.num_decodes == 2 and built.num_decode_tokens == 5
+    assert built.prefill is None
+    assert getattr(built, "hisparse_prefill_plan", None) is None
+
+
+def test_shared_dcp_decode_has_no_p_staging(model, monkeypatch):
+    builder = _builder(model, monkeypatch, rank=0)
+    common = _metadata(0, decode_only=True)
+    built = builder.build(0, common)
+    assert built.num_decodes == 1 and built.num_decode_tokens == 4
+    assert built.num_prefills == 0
+    assert getattr(built, "hisparse_prefill_plan", None) is None
+    assert built.block_table is common.block_table_tensor
+    assert built.slot_mapping is common.slot_mapping
+
+
+class CpuGather:
+    """Replace only the final UVM DMA kernel, keeping native gather orchestration."""
+
+    def __init__(self):
+        self.host_rows = []
+
+    def hisparse_gather_plan(self, source, staged, row_ids, destination, mask):
+        miss = mask.flatten().bool()
+        rows = row_ids.flatten()[miss].long()
+        self.host_rows.extend(rows.tolist())
+        width = staged.shape[-1]
+        staged.view(-1, width)[destination.flatten()[miss].long()] = source[rows]
+
+
+def _native_stage(metadata, common, rank, *, malformed_writer=None, ram_tail=False):
+    row_width = 528
+    source = torch.zeros((94, BLOCK, row_width), dtype=torch.uint8)
+    for i in (7, 9, 11, 13):
+        source[i].fill_(i)
+    residency = torch.full((8, 3), 6, dtype=torch.int32)
+    state = torch.tensor([4, 6, 2, 3, 1], dtype=torch.int32)
+    # P prefix block 7 is in RAM on ranks 1–3, and already resident on rank 0.
+    residency[6, 0] = residency[2, 0] = 8 if rank == 0 else 0
+    residency[1].zero_()
+    if ram_tail:
+        residency[2, 1] = 0
+    writer_slots = torch.full_like(common.slot_mapping, -1)
+    for pos, host_id in enumerate(common.slot_mapping[4:], start=4):
+        if host_id < 0:
+            continue
+        host_block, offset = divmod(int(host_id), BLOCK)
+        writer_slots[pos] = {9: 31, 11: 32, 13: 33}[host_block] * BLOCK + offset
+    if malformed_writer is not None:
+        writer_slots[4] = malformed_writer
+
+    runtime = object.__new__(HiSparseRuntime)
+    runtime.kv_dtype = torch.uint8
+    runtime.row_width = row_width
+    runtime.request_state_indices = state
+    runtime.backend = HiSparseBackend()
+    runtime.cache_ops = CpuGather()
+    cache = HiSparseCacheHandle(runtime)
+    # Actual paged device view, backed by CPU tensor for this one replay.
+    resident = torch.zeros((34, BLOCK, row_width), dtype=torch.uint8)
+    resident[6].fill_(16)  # A stale table candidate must never supply P writers.
+    resident[8].fill_(108)
+    for i in (31, 32, 33):
+        resident[i].fill_(200 + i)
+    cache.bind_cache(
+        resident.flatten(),
+        byte_offset=0,
+        block_stride=BLOCK * row_width,
+        num_blocks=resident.shape[0],
+        block_size=BLOCK,
+        block_table=residency,
+        slot_mapping=writer_slots,
+    )
+    group = object.__new__(HiSparseMLAIndexGroup)
+    group.caches = [cache]
+    staged, table, reqs = group.stage_prefill_rows(0, source, metadata)
+    return staged, table, reqs, runtime.cache_ops.host_rows
+
+
+@pytest.mark.parametrize("rank", range(4))
+def test_candidate_native_rank_plan_and_mixed_stage(model, monkeypatch, rank):
+    metadata, common = _actual_mixed_builder(
+        model, monkeypatch, rank, with_positions=rank != 2
+    )
+    assert metadata.num_decodes == 1 and metadata.num_decode_tokens == 4
+    assert metadata.num_prefills == 4
+    assert metadata.prefill is None
+    plan = metadata.hisparse_prefill_plan
+    assert plan is not None
+    capacity = (5, 4, 4, 2)[rank]
+    live_tail = (4, 4, 1, 0)[rank]
+    short_tail = int(rank == 0)
+    assert plan.row_ids.shape == (1, (capacity + 1) * BLOCK)
+    assert int(plan.writer_mask.sum()) == short_tail + 2 * live_tail
+    assert not plan.block_table[3].any()  # Padding has no borrowed or active rows.
+    assert torch.equal(metadata.block_table, common.block_table_tensor)
+
+    staged, table, reqs, host_reads = _native_stage(metadata, common, rank)
+    expected = [] if rank == 0 else list(range(7 * BLOCK, 8 * BLOCK))
+    assert sorted(host_reads) == expected
+    prefix = 108 if rank == 0 else 7
+    assert (staged[table[0, 0]] == prefix).all()
+    assert (staged[table[1, 0]] == prefix).all()
+    if short_tail:
+        assert (staged[table[0, 1], :short_tail] == 231).all()
+    if live_tail:
+        assert (staged[table[1, 1], :live_tail] == 232).all()
+        assert (staged[table[2, 0], :live_tail] == 233).all()
+    assert reqs.tolist() == [0] + [1] * 9 + [2] * 9
+
+
+def test_candidate_same_page_historical_and_writer_rows_are_distinct(
+    model, monkeypatch
+):
+    builder = _builder(model, monkeypatch, rank=0)
+    common = _metadata(0, warm_query=7)
+    built = builder.build(0, common)
+    staged, table, _, reads = _native_stage(built, common, rank=0, ram_tail=True)
+    assert sorted(reads) == [11 * BLOCK, 11 * BLOCK + 1]
+    partial = staged[table[1, 1]]
+    assert (partial[:2] == 11).all()
+    assert (partial[2:4] == 232).all()
+
+
+def test_candidate_rejects_wrong_source_page_or_rank(model, monkeypatch):
+    builder = _builder(model, monkeypatch, 0)
+    common = _metadata(0)
+    common.slot_mapping[4] = 10 * BLOCK  # Young P slot under a different block.
+    with pytest.raises(RuntimeError, match="does not own its native source slot"):
+        builder.build(0, common)
+
+    common = _metadata(0)
+    common.slot_mapping[9] = 11 * BLOCK  # Query 1028 belongs to rank 1.
+    with pytest.raises(RuntimeError, match="does not own its native source slot"):
+        builder.build(0, common)
+
+
+def test_candidate_rejects_duplicate_writer_or_a_stale_query_position(
+    model, monkeypatch
+):
+    builder = _builder(model, monkeypatch, 0)
+    common = _metadata(0)
+    common.block_table_tensor[2, 1] = common.block_table_tensor[1, 1]
+    common.slot_mapping[5:9] = 9 * BLOCK + torch.arange(4)
+    with pytest.raises(RuntimeError, match="writes alias a staging row"):
+        builder.build(0, common)
+
+    common = _metadata(0)
+    common.positions[4] = 1023
+    with pytest.raises(RuntimeError, match="cover the current query suffix"):
+        builder.build(0, common)
+
+
+@pytest.mark.parametrize("slot", [-1, 0, 35 * BLOCK, 31 * BLOCK + 1])
+def test_candidate_does_not_dma_a_missing_or_null_writer(model, monkeypatch, slot):
+    metadata, common = _actual_mixed_builder(model, monkeypatch, rank=0)
+    with pytest.raises(RuntimeError, match="does not own its native resident slot"):
