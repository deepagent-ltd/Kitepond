+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Preallocation checks for an explicitly capable HiSparse DCP runner."""
+
+from dataclasses import dataclass
+from math import isfinite
+from typing import TYPE_CHECKING
+
+import torch
+
+from vllm.config import VllmConfig, get_layers_from_vllm_config
+from vllm.config.kv_transfer import hisparse_host_pool_gib
+from vllm.distributed.parallel_state import GroupCoordinator
+from vllm.model_executor.layers.attention_layer_base import AttentionLayerBase
+from vllm.platforms import current_platform
+from vllm.platforms.interface import DeviceCapability
+from vllm.utils.math_utils import cdiv
+from vllm.v1.core.kv_cache_utils import resolve_dcp_kv_block_size
+from vllm.v1.kv_cache_interface import (
+    HiSparseResidentSpec,
+    MLAAttentionSpec,
+    SparseCacheRole,
+    iter_layer_specs,
+)
+from vllm.v1.worker.cp_utils import check_attention_cp_compatibility
+
+if TYPE_CHECKING:
+    from vllm.v1.kv_cache_interface import KVCacheConfig
+    from vllm.v1.kv_cache_layout import KVCacheLayout
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+
+
+@dataclass(frozen=True)
+class HiSparseDCPLayout:
+    """Rank-local physical allocation and its scheduler token span."""
+
+    rank: int
+    world_size: int
+    interleave: int
+    physical_page_rows: int
+    logical_page_tokens: int
+    minimum_host_blocks: int
+    device_layout: "KVCacheLayout"
+    packed_row_bytes: int = 528
+
+
+def _dcp8_source_geometry(config: VllmConfig) -> tuple[int, int]:
+    if getattr(config.attention_config, "enable_glm53_full_dcp8", False):
+        return 64, 656
+    return 256, 528
+
+
+def validate_hisparse_dcp8_config(config: VllmConfig) -> None:
+    """Restrict the first host-backed DCP lane to one exact native layout."""
+    hisparse = config.attention_config.hisparse_config
+    if hisparse is None or not hisparse.enable_dcp8:
+        raise ValueError("HiSparse does not support decode context parallelism.")
+
+    parallel = config.parallel_config
+    if (
+        (
+            parallel.tensor_parallel_size,
+            parallel.decode_context_parallel_size,
+            parallel.prefill_context_parallel_size,
+            parallel.pipeline_parallel_size,
+            parallel.data_parallel_size,
+            parallel.cp_kv_cache_interleave_size,
+        )
+        != (8, 8, 1, 1, 1, 4)
+        or parallel.dcp_kv_cache_interleave_size not in (1, 4)
+        or parallel.dcp_comm_backend not in (None, "ag_rs")
+        or parallel.dcp_q_replicate
+        or parallel.distributed_executor_backend != "mp"
+        or parallel.nnodes_within_dp != 1
+        or not parallel.enable_expert_parallel
+        or parallel.enable_eplb
+        or parallel.enable_elastic_ep
+        or config.speculative_config is not None
+    ):
+        raise ValueError(
+            "HiSparse DCP8 requires single-node MP, TP8/EP8/DCP8/DP1/PP1/PCP1, "
+            "interleave 4, ag_rs, and no speculative decoding or expert rebalancing."
+        )
+
+    physical_rows, packed_row_bytes = _dcp8_source_geometry(config)
+    cache = config.cache_config
+    if (
+        not cache.user_specified_block_size
+        or cache.block_size != physical_rows
+        or cache.cache_dtype != "fp8_ds_mla"
+        or cache.enable_prefix_caching
+        or cache.enable_extensible_kv_cache is not False
+        or not hisparse.eager_host_mirror
+        or cache.kv_cache_dtype_skip_layers
+        or cache.mamba_cache_mode != "none"
+        or cache.mamba_page_size_padded is not None
+        or config.scheduler_config.disable_hybrid_kv_cache_manager
+    ):
+        raise ValueError(
+            f"HiSparse DCP8 requires explicit B{physical_rows}, "
+            "fp8_ds_mla, eager host "
+            "mirroring, hybrid KV management, and prefix caching and extensible "
+            "KV cache disabled."
+        )
+
+    kv = config.kv_transfer_config
+    if (
+        kv is None
+        or kv.kv_connector != "HiSparseConnector"
+        or kv.kv_role != "kv_both"
+        or kv.kv_connector_extra_config.get("host_pool_allocator") is not None
+    ):
+        raise ValueError(
+            "HiSparse DCP8 requires a direct HiSparseConnector. "
+            "host_pool_allocator remains restricted to TP1."
+        )
+    provider = config.additional_config.get("hisparse_host_buffer_provider")
+    if provider is not None and (
+        not isinstance(provider, str)
+        or "." not in provider
+        or not all(part.isidentifier() for part in provider.split("."))
+    ):
+        raise ValueError("HiSparse DCP8 host buffer provider must be a qualified name.")
+    host_pool_gib = hisparse_host_pool_gib(kv)
+    if host_pool_gib is None or not isfinite(host_pool_gib):
+        raise ValueError("HiSparse DCP8 requires a finite host_pool_gib.")
+
+    from vllm.utils.flashinfer import has_flashinfer_sparse_mla_sm120
+    from vllm.v1.attention.backends.mla.flashinfer_mla_sparse import (
+        FlashInferMLASparseSM120Backend,
+    )
+    from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+    model = config.model_config
+    text = model.hf_text_config if model is not None else None
+    quant = getattr(model.hf_config, "quantization_config", None) if model else None
+    weight_block_size = (
+        quant.get("weight_block_size") if isinstance(quant, dict) else None
+    )
+    is_flash_nvfp4 = (
+        isinstance(quant, dict)
+        and quant.get("quant_method") == "modelopt"
+        and quant.get("quant_algo") == "NVFP4"
+    )
+    is_flash_fp8 = (
+        isinstance(quant, dict)
+        and model is not None
+        and quant.get("quant_method") == "fp8"
+        and model.quantization == "fp8"
+        and quant.get("fmt") == "e4m3"
+        and quant.get("activation_scheme") == "dynamic"
+        and isinstance(weight_block_size, list)
+        and weight_block_size == [128, 128]
+        and all(type(value) is int for value in weight_block_size)
+    )
+    if packed_row_bytes == 656:
+        if (
+            not FlashInferMLASparseSM120Backend.supports_glm53_full_dcp8(config)
+            or hisparse.indexer_block_size is not None
+        ):
+            raise ValueError(
+                "Full GLM-5.3 HiSparse DCP8 requires the original "
+                "GLM packed-RoPE layout and uncompressed B64 indexer."
+            )
+    elif (
+        model is None
+        or model.architecture != "Glm5NextForConditionalGeneration"
+        or model.dtype != torch.bfloat16
+        or getattr(text, "model_type", None) != "glm5_next_text"
+        or getattr(text, "num_attention_heads", None) != 64
+        or getattr(text, "kv_lora_rank", None) != 512
+        or getattr(text, "qk_nope_head_dim", None) != 256
+        or getattr(text, "qk_rope_head_dim", None) != 0
+        or getattr(text, "index_topk", None) != 2048
+        or getattr(text, "index_kpool", None) != 4
+        or not getattr(text, "index_kpool_compress", False)
+        or not (is_flash_nvfp4 or is_flash_fp8)
+    ):
+        raise ValueError(
+            "HiSparse DCP8 requires compact GLM-5.3-Flash NVFP4 "
+            "or native E4M3 block FP8."
+        )
+
+    attention = config.attention_config
+    backend = attention.backend_per_kind.get("mla_attention", attention.backend)
+    if (
+        not current_platform.is_cuda()
+        or current_platform.get_device_capability() != DeviceCapability(12, 0)
+        or backend != AttentionBackendEnum.FLASHINFER_MLA_SPARSE_SM120
+        or not FlashInferMLASparseSM120Backend.supports_dcp()
+        or not has_flashinfer_sparse_mla_sm120()
+    ):
+        raise ValueError(
+            "HiSparse DCP8 requires SM120 and explicit "
+            "FLASHINFER_MLA_SPARSE_SM120 with FlashInfer >= 0.7.3."
+        )
+
+
+def validate_dcp8_rank_agreement(
+    group: GroupCoordinator,
+    layout: HiSparseDCPLayout,
+    cache: "KVCacheConfig",
+    local_matches: bool,
+    host_buffer_provider: str | None,
+) -> None:
+    """Ensure all eight workers will allocate compatible block tables and host pages."""
+    (host_group_id,) = cache.host_group_ids
+    host_group = cache.kv_cache_groups[host_group_id]
+    host = host_group.kv_cache_spec
+    geometry = (layout.physical_page_rows, layout.packed_row_bytes)
+    local_matches = (
+        local_matches
+        and geometry in ((256, 528), (64, 656))
+        and (geometry != (64, 656) or len(host_group.layer_names) == 78)
+        and all(
+            isinstance(spec, MLAAttentionSpec)
+            and spec.cache_dtype_str == "fp8_ds_mla"
+            and spec.cache_role == SparseCacheRole.SPARSE
+            and spec.tokens_per_state == 1
+            and spec.page_size_bytes
+            == layout.packed_row_bytes * layout.physical_page_rows
+            and (
+                geometry != (64, 656)
+                or (
+                    spec.head_size == 576
+                    and spec.num_kv_heads == 1
+                    and spec.dtype == torch.uint8
+                )
+            )
+            for spec in iter_layer_specs(host)
+        )
+    )
+    descriptor = (
+        layout.world_size,
+        layout.interleave,
+        layout.physical_page_rows,
+        layout.packed_row_bytes,
+        layout.logical_page_tokens,
+        layout.minimum_host_blocks,
+        layout.device_layout.name,
+        cache.num_blocks,
+        cache.hisparse_host_num_blocks,
+        cache.hisparse_host_block_stride,
+        host_buffer_provider,
+        tuple(
+            (g.kv_cache_spec.block_size, g.kv_cache_spec.dcp_sharded, g.host_resident)
+            for g in cache.kv_cache_groups
+        ),
+    )
+    reports = [None] * group.world_size
+    torch.distributed.all_gather_object(
+        reports, (layout.rank, local_matches, descriptor), group=group.cpu_group
+    )
+    if reports != [(rank, True, descriptor) for rank in range(8)]:
+        raise ValueError("HiSparse DCP8 workers disagree on cache layout or ranks.")
+
+
+def require_hisparse_dcp_layout(
+    runner: "GPUModelRunner", cache: "KVCacheConfig"
+) -> HiSparseDCPLayout:
+    """Require cooperation from the actual runner before allocating DCP HiSparse KV."""
+    config = runner.vllm_config
+    parallel = config.parallel_config
+    dcp_size = parallel.decode_context_parallel_size
+    if (
+        config.attention_config.hisparse_config is None
+        or dcp_size <= 1
+        or parallel.prefill_context_parallel_size != 1
+        or parallel.pipeline_parallel_size != 1
+        or runner.dcp_size != dcp_size
+        or not 0 <= runner.dcp_rank < dcp_size
+        or runner.cp_interleave != parallel.cp_kv_cache_interleave_size
+        or runner.cp_interleave < 1
+    ):
+        raise ValueError("HiSparse DCP requires an exact rank-local runner topology.")
+
+    host = [group for group in cache.kv_cache_groups if group.host_resident]
+    resident = [
+        group.kv_cache_spec
+        for group in cache.kv_cache_groups
+        if isinstance(group.kv_cache_spec, HiSparseResidentSpec)
+    ]
+    if len(host) != 1 or not resident:
+        raise ValueError("HiSparse DCP requires a host source and resident groups.")
+    source = host[0].kv_cache_spec
+    # A uniform group advertises a representative spec. Verify every admitted
+    # source layer instead of assuming that the backend picked one row shape.
+    local_rows = source.block_size
+    expected_rows, packed_row_bytes = _dcp8_source_geometry(config)
+    if (
+        local_rows != expected_rows
+        or any(
+            not isinstance(spec, MLAAttentionSpec)
+            or not spec.dcp_sharded
+            or spec.block_size != local_rows
+            for spec in iter_layer_specs(source)
+        )
+        or any(
+            not spec.dcp_sharded or spec.block_size != local_rows for spec in resident
+        )
+        or local_rows % runner.cp_interleave
+    ):
+        raise ValueError("HiSparse DCP source and resident have incompatible pages.")
+
+    logical_tokens = resolve_dcp_kv_block_size(source, dcp_size)
+    host_blocks = cdiv(config.model_config.max_model_len, logical_tokens) + 2
+    if (
+        cache.hisparse_shared_host_pool
+        or cache.hisparse_host_block_stride != source.page_size_bytes
+        or (cache.hisparse_host_num_blocks or 0) < host_blocks
+    ):
+        raise ValueError("HiSparse DCP requires exact rank-local host geometry.")
+
+    layout = config.cache_config.get_resolved_kv_cache_layout()
+    if not layout.is_block_outermost:
+        raise ValueError("HiSparse DCP requires a block-outermost device layout.")
+    if cache.kv_cache_layout is not None and cache.kv_cache_layout != layout.name:
+        raise ValueError("HiSparse DCP requires the engine's resolved device layout.")
+
+    from vllm.v1.core.kv_cache_planning import validate_kv_cache_layout
+
+    validate_kv_cache_layout(
+        layout, [g for g in cache.kv_cache_groups if not g.host_resident]
+    )
+    source_layers = get_layers_from_vllm_config(
+        config, AttentionLayerBase, host[0].layer_names
+    )
+    if not source_layers or source_layers.keys() != set(host[0].layer_names):
+        raise ValueError("HiSparse DCP requires every resolved source layer.")
+    for name, layer in source_layers.items():
+        implementation = getattr(layer, "impl", None)
+        if (
+            getattr(implementation, "supports_dcp", False) is not True
+            or getattr(implementation, "can_return_lse_for_decode", False) is not True
+            or getattr(implementation, "need_to_return_lse_for_decode", False)
+            is not True
+        ):
+            raise ValueError(f"HiSparse DCP source {name!r} cannot return decode LSE.")
+
+    check_attention_cp_compatibility(config)
+    admitted = HiSparseDCPLayout(
+        rank=runner.dcp_rank,
+        world_size=dcp_size,
+        interleave=runner.cp_interleave,
+        physical_page_rows=local_rows,
+        logical_page_tokens=logical_tokens,
+        minimum_host_blocks=host_blocks,
+        device_layout=layout,
+        packed_row_bytes=packed_row_bytes,
+    )
+    # Ordinary DCP/LSE support is insufficient. This explicitly selected
+    # runner must verify its HiSparse staging, mirroring and physical readers.
+    runner.validate_hisparse_dcp_execution(cache, admitted)
+    return admitted
