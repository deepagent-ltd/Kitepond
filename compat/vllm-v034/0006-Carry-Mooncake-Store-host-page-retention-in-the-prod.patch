+    def _pin_save(
+        self, req_meta: ReqMeta, block_refs: Iterable[tuple[int, int]]
+    ) -> None:
+        coord = self._store_coord
+        gpu_pool = self._gpu_block_pool
+        assert coord is not None and gpu_pool is not None
+        group_pools: dict[int, BlockPool] = {}
+        ids_by_pool: dict[BlockPool, dict[int, None]] = {}
+        for group_id, block_id in block_refs:
+            assert block_id != NULL_BLOCK_ID, "A null block cannot back a store job"
+            pool = group_pools.get(group_id)
+            if pool is None:
+                pool = gpu_pool
+                if coord.kv_cache_groups[group_id].host_resident:
+                    manager = self._kv_cache_manager
+                    if manager is None:
+                        raise RuntimeError("Mooncake Store has no host cache manager")
+                    pool = manager.get_group_block_pool(self._store_group_ids[group_id])
+                    if pool is gpu_pool:
+                        raise RuntimeError("Mooncake Store host pool is not bound")
+                group_pools[group_id] = pool
+            if not 0 < block_id < len(pool.blocks):
+                raise ValueError(f"Mooncake Store block ID {block_id} is out of range")
+            ids_by_pool.setdefault(pool, {})[block_id] = None
+
+        # Resolve all IDs before taking any references. IDs can overlap across
+        # pools, but a physical block needs at most one reference per job.
+        blocks_by_pool = {
+            pool: [pool.blocks[block_id] for block_id in ids]
+            for pool, ids in ids_by_pool.items()
+        }
+        req_meta.store_job_id = store_job_id = self._next_store_job_id
+        self._next_store_job_id += 1
+        if not blocks_by_pool:
+            return
+        for pool, blocks in blocks_by_pool.items():
+            pool.touch(blocks)
+        self._pinned_saves[store_job_id] = (blocks_by_pool, self._num_workers)
 
