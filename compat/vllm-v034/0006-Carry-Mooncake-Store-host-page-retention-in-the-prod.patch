+@pytest.mark.parametrize("finished_lookahead", [False, True])
+def test_store_job_pins_distinct_blocks_with_matching_ids(finished_lookahead):
+    scheduler = _make_bare_scheduler(hash_block_size=4)
+    scheduler._num_workers = 2
+    # Store uses compact group indices. The live cache manager keeps the
+    # group IDs from the complete configuration, including skipped groups.
+    scheduler._store_group_ids = (1, 2)
+    scheduler._boundary_state_group_ids = frozenset()
+    spec = scheduler._store_coord.kv_cache_groups[0]
+    scheduler._store_coord = MooncakeStoreCoordinator(
+        [replace(spec, host_resident=True), spec],
+        16,
+        4,
+        use_eagle=False,
+        num_hash_lookahead_tokens=int(finished_lookahead),
+    )
+    device = scheduler._gpu_block_pool
+    host = _bind_host_group(scheduler, 1)
+    # The same numeric ID exists in both pools. The second CPU block does
+    # not have a matching device ID at all.
+    block_ids = ([7, 70, 7], [7])
+    hashes = [bytes([i]) for i in range(12)]
+    if finished_lookahead:
+        request = SimpleNamespace(
+            request_id="req-0",
+            num_computed_tokens=48,
+            num_in_flight_tokens=0,
+            num_stale_output_tokens=0,
+            num_prompt_tokens=48,
+            num_tokens=48,
+            all_token_ids=list(range(48)),
+            block_hashes=hashes,
+        )
+        scheduler._request_trackers["req-0"] = RequestTracker(
+            req_id="req-0",
+            token_len=48,
+            allocated_block_ids=block_ids,
+            token_ids=list(range(48)),
+            prefill_end_tokens=48,
+        )
+        scheduler.register_finished_lookahead_save(request, ([], *block_ids))
+        req_meta = scheduler._finished_lookahead_metas["req-0"]
+    else:
+        req_meta = ReqMeta("req-0", 48, block_ids, hashes, can_save=True)
+        scheduler._reference_save_blocks([req_meta])
+
+    job_id = req_meta.store_job_id
+    assert scheduler._pinned_saves[job_id] == (
+        {host: [host.blocks[7], host.blocks[70]], device: [device.blocks[7]]},
+        2,
+    )
+    blocks = [host.blocks[7], host.blocks[70], device.blocks[7]]
+    assert [block.ref_cnt for block in blocks] == [1, 1, 1]
+    scheduler.update_connector_output(_make_worker_output({job_id: 1}))
+    assert [block.ref_cnt for block in blocks] == [1, 1, 1]
+    scheduler.update_connector_output(_make_worker_output({job_id: 1}))
+    assert [block.ref_cnt for block in blocks] == [0, 0, 0]
+
+
+def test_store_job_does_not_pin_anything_when_host_pool_is_unavailable():
+    scheduler = _make_bare_scheduler()
+    spec = scheduler._store_coord.kv_cache_groups[0]
+    scheduler._store_coord = MooncakeStoreCoordinator(
+        [spec, replace(spec, host_resident=True)], 16, 16, use_eagle=False
+    )
+    scheduler._boundary_state_group_ids = frozenset()
+    req_meta = ReqMeta("req-0", 16, ([7], [7]), [b"h"], can_save=True)
+    with pytest.raises(RuntimeError, match="no host cache manager"):
+        scheduler._reference_save_blocks([req_meta])
+    assert req_meta.store_job_id is None
+    assert scheduler._pinned_saves == {}
+    assert scheduler._gpu_block_pool.blocks[7].ref_cnt == 0
